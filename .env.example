# Remplis ces variables puis renomme/copie ce fichier en .env
# (le .env est ignore par git, il ne sera jamais commit)

# Supabase : jeton d'acces personnel (Dashboard > Account > Access Tokens)
SUPABASE_ACCESS_TOKEN=

# GitHub : Personal Access Token (github.com > Settings > Developer settings > Tokens)
GITHUB_PERSONAL_ACCESS_TOKEN=

# PostgreSQL : chaine de connexion (ex: postgresql://user:pass@host:5432/db)
POSTGRES_CONNECTION_STRING=

# Context7 : cle API (context7.com)
CONTEXT7_API_KEY=

# Firecrawl : cle API (firecrawl.dev) - optionnel
FIRECRAWL_API_KEY=

# Dossier racine autorise pour le MCP filesystem (ex: C:/Users/<toi>/projets)
FILESYSTEM_ROOT=
